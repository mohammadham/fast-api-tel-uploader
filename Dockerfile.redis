FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

# --- Redis optional dependency ---
# Set TGDRIVE_REDIS_ENABLED=1 at runtime to enable Redis
# This Dockerfile always installs redis-py but the app checks the env var at startup
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libffi-dev && \
    rm -rf /var/lib/apt/lists/* && \
    pip install redis asyncio-redis

WORKDIR /srv

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libffi-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY static ./static

RUN useradd -m -u 1000 tgdrive && mkdir -p /srv/data && chown -R tgdrive /srv
USER tgdrive

ENV TGDRIVE_DATA_DIR=/srv/data \
    TGDRIVE_REDIS_ENABLED=0 \
    TGDRIVE_SECRET=dev-secret-change-me-please-32-chars!

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/admin/healthz').status==200 else 1)"

# Start command - supports both Redis and non-Redis modes
# If TGDRIVE_REDIS_ENABLED=1 and TGDRIVE_REDIS_URL is set, Redis will be used
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]