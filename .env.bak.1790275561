# TelegramDrive minimal config for eitaa testing
# This is a zero-data startup - all DB tables will be created fresh

# ── fake TG mode (1 = use in-memory fake, 0 = real TG needed)──
TGDRIVE_FAKE_TG=0

# ── security ──
TGDRIVE_SECRET=test-minimal-secret-change-me-32-chars!

# ── admin ──
TGDRIVE_ADMIN_USERNAME=admin
TGDRIVE_ADMIN_PASSWORD=

# ── default backend ──
TGDRIVE_DEFAULT_BACKEND=eitaa

# ── eitaa ──
# Get token from: https://eitaayar.ir
TGDRIVE_EITAA_TOKEN=test-eitaa-token-for-demo

# ── telegram (only needed for private channel fallback) ──
TGDRIVE_API_ID=
TGDRIVE_API_HASH=

# ── web ──
TGDRIVE_PORT=8888

# ── logging ──
TGDRIVE_LOG_LEVEL=INFO
