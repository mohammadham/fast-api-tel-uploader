[TEMPLATE]

# ─── TelegramDrive ────────────────────────────────────────────
# امنیت (حتماً تغییر دهید؛ حداقل ۳۲ کاراکتر)
TGDRIVE_SECRET=please-change-me-to-a-long-random-string-32

# ادمین پنل (اگر خالی باشد در اولین اجرا رمز تولید و در data/initial_admin_password.txt ذخیره می‌شود)
TGDRIVE_ADMIN_USERNAME=admin
TGDRIVE_ADMIN_PASSWORD=

# حالت تست/توسعه بدون تلگرام واقعی (1 = فعال)
TGDRIVE_FAKE_TG=0

# بک‌اند ذخیره‌سازی پیش‌فرض سیستم (telegram | eitaa)
# کلیدهای API می‌توانند با فیلد backend این را override کنند
TGDRIVE_DEFAULT_BACKEND=telegram

# API تلگرام — از https://my.telegram.org (برای حالت realequisite)
TGDRIVE_TG_API_ID=
TGDRIVE_TG_API_HASH=

# ─── ایتاayar ──────────────────────────────────────────────────
# توکن ایتا (برای آپلود و مدیریت فایل در ایتا.ir)
# دریافت کنید از: https://eitaayar.ir
TGDRIVE_EITAA_TOKEN=

# ─── privée channel support (eitaa) ────────────────────────────
# پشتیبانی کانال‌های خصوصی ایتا (نیاز به احراز هویت MTProto دارد)
# برای استفاده کانال‌هایstarting با @ (مثل @private_channel) تنظیم کنید:
TGDRIVE_SESSION_STR=  # session string from my.telegram.org (required for private channels)
TGDRIVE_API_ID=  # Telegram API ID from my.telegram.org
TGDRIVE_API_HASH=  # Telegram API hash from my.telegram.org

# ─── Redis queue scaling (v2 feature) ──────────────────────────
# برای مقیاس‌پذیری چندپروسه‌ای با Redisenabled کنید:
TGDRIVE_REDIS_URL=redis://localhost:6379/0  # empty → SQLite only
TGDRIVE_REDIS_ENABLED=false  # set to "true" to enable Redis backend

# ─── محیط/شبکه ───────────────────────────────────────────────
# foregn API base (برای باط مستقیم تلگرام)
TGDRIVE_BOT_API_BASE=https://api.telegram.org

# آی‌دی‌های تلگرام مجاز برای کنترل بات (جدا با کاما)
TGDRIVE_BOT_ADMIN_IDS=

# ─── لاگ ساختاریافته ──────────────────────────────────────────
# سطح لاگ (DEBUG | INFO | WARNING | ERROR) — خروجی همیشه JSON ساختاریافته است
# هر خط: ts, level, logger, msg, request_id, correlation_id, job_id + فیلدهای رویداد
# کلاینت‌ها می‌توانند X-Request-ID / X-Correlation-ID بفرستند و همان را در پاسخ بگیرند
TGDRIVE_LOG_LEVEL=INFO

# ─── 区域 / Region specific ────────────────────────────────────
# FastAPI port
TGDRIVE_PORT=8000
# --- External database / multi-server (v2.1) ---
# Postgres URL; empty = local SQLite (default). MySQL is not supported.
# TGDRIVE_DATABASE_URL=postgres://user:pass@host:5432/telegramdrive
# Unique node id for multi-server deploys (default: hostname)
TGDRIVE_NODE_ID=
